# ===========================================================
# DriveBase Root .gitignore
# ===========================================================
# ----- Secrets & Environment -----
.env
.env.*
*.secret
*.key
*.pem
*.p12
*.pfx

# ----- Database -----
db.sqlite3
*.sqlite3
*.sqlite
schema.prisma

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
acar_venv/
drivebase_venv/
env/
venv/
ENV/

# ----- Node -----
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ----- Build artifacts -----
dist/
dist-ssr/
staticfiles/

# ----- Media (user uploads) -----
media/

# ----- Reference / scratch files -----
reference_files_only/

# ----- IDE & Editor -----
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- Logs -----
*.log
test_output.txt

# ----- Generated PDFs (dev only) -----
*.pdf
.gitnexus

/start_gitnexus.bat

# Production env template is committed, actual .env.production is not
backend/.env.production

# Docker volumes
certbot/

# Server backups (never in git)
backups/

# deploy script output
scripts/*.log

# deployment on oracle server instructions
instructions.md

reference_ui/

# ----- Test artifacts & Playwright (dev & E2E) -----
test_artifacts/
test-results/
playwright-report/
.auth/

# ----- Agent Scratch temporary files -----
.agents/scratch/
